{
  "name": "image-processing-algorithms",
  "version": "2.0.0",
  "description": "This is an implementation of Floyd-Steinberg Algorithm.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "type-check": "tsc --project ./tsconfig.json --noEmit --skipLibCheck",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-canvas-mock": "^1.2.0"
  },
  "keywords": [
    "Floyd-Steinberg",
    "grayscale",
    "reverse pixels"
  ],
  "author": "Jakub Grzywaczewski",
  "license": "MIT",
  "homepage": "https://github.com/jakubgrzywaczewski/image-processing-algorithms",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@10.15.1"
}
